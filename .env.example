# Copy to .env and edit. Never commit .env.
HYDROGEOAI_DATA_DIR=./data
HYDROGEOAI_RESULTS_DIR=./results
HYDROGEOAI_REGISTRY_URL=sqlite:///./experiments_registry/registry.db
# Optional PostGIS (docker compose up db)
HYDROGEOAI_POSTGIS_URL=postgresql+psycopg://hydrogeoai:hydrogeoai@localhost:5432/hydrogeoai
# Admin endpoints require this key in the X-API-Key header
HYDROGEOAI_ADMIN_KEY=change-me
# Web frontend -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Hugging Face (optional; `hf auth login` is preferred; used only by `hydrogeoai hf publish --push`)
HF_TOKEN=
HF_NAMESPACE=your-hf-username
